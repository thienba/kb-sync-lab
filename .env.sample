# Copy to .env and fill in. Never commit .env.
# OpenAI key (OPENAI_API_KEY is accepted as an alias)
API_KEY=your-openai-key-here
# Existing vector store to reuse; leave empty to find or create one by name
VECTOR_STORE_ID=
VECTOR_STORE_NAME=optibot-kb-dev
OPENAI_MODEL=gpt-5.4-mini
# Optional heartbeat URL pinged after a successful run
HEALTHCHECK_URL=
# Where the status page and run history are written. Leave these unset in Docker: the image
# sets its own paths, and its non-root user cannot create these relative ones.
# PUBLIC_DIR=public
# OUT_DIR=out
# Set to 1 to ignore saved state and rebuild everything
FULL_REBUILD=0
# Chunking (measured in docs/chunking.md)
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=150
